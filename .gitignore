# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/
.venv/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Ruff
.ruff_cache/

# Jupyter
.ipynb_checkpoints/
notebooks/*.nbconvert.*

# Plotly HTML exports
*.html

# OS
.DS_Store

# Editors
.vscode/
.idea/

# Crush (Claude)
.crush/

# Data (large files, downloaded/generated per-machine)
data/**/*.pdb
data/**/*.cif

# Large regenerable tensors stay out of git (rebuild with scripts/fetch_msa_couplings.py
# and the data/*/prepare_*.py scripts). The small distance/coupling inputs the frozen
# reference pipeline needs at clone time are whitelisted below so the repo reproduces.
data/**/*.npz
!data/gb1/gb1_distances.npz
!data/gb1/gb1_msa_couplings.npz
!data/trpb/trpb_distances.npz
!data/trpb/trpb_msa_couplings.npz
!data/creilov/creilov_distances.npz
!data/gfp/gfp_distances.npz

# Generated validation / pilot outputs (rebuilt by scripts/rebuild_reference_outputs.py)
notebooks/validation/output_*/
notebooks/iclr/output_*/
notebooks/benchmark_pilot/

# Large raw upstream data (regenerated by data/*/prepare_*.py)
data/creilov/creilov_combinatorial_raw.xlsx
data/trpb/trpb4_raw.csv
data/trpb/trpb4_scaled.csv

# Web (Bun / TS viz at /web/)
.mutascape/
web/node_modules/
web/dist/
web/bun.lock
!web/index.html

# Rebuilt by scripts/build_suite.py
suite/
