    {
      "entries": [
        {
          "name": "DMSLandscape.from_singles",
          "notes": [
            {
              "kind": "text",
              "text": "Strength scales unit-variance pair effects by the standard deviation of the measured single effects. Contacts restrict which site pairs can interact. A frozen `completion` adds imputed singles, which share the readout fitted to measured singles."
            }
          ],
          "parameters": [
            {
              "annotation": "str",
              "default": "",
              "keywordOnly": false,
              "name": "sequence"
            },
            {
              "annotation": "DataFrame",
              "default": "",
              "keywordOnly": false,
              "name": "singles"
            },
            {
              "annotation": "int",
              "default": "0",
              "keywordOnly": true,
              "name": "seed"
            },
            {
              "annotation": "float",
              "default": "0.3",
              "keywordOnly": true,
              "name": "strength"
            },
            {
              "annotation": "Literal['linear', 'sigmoid', 'pool']",
              "default": "'sigmoid'",
              "keywordOnly": true,
              "name": "mode"
            },
            {
              "annotation": "float",
              "default": "0.05",
              "keywordOnly": true,
              "name": "margin"
            },
            {
              "annotation": "set[tuple[int, int]] | None",
              "default": "None",
              "keywordOnly": true,
              "name": "contacts"
            },
            {
              "annotation": "int | None",
              "default": "None",
              "keywordOnly": true,
              "name": "maximum_depth"
            },
            {
              "annotation": "Mapping | None",
              "default": "None",
              "keywordOnly": true,
              "name": "completion"
            }
          ],
          "returns": "Self",
          "signature": "DMSLandscape.from_singles(sequence: str, singles: DataFrame, *, seed: int = 0, strength: float = 0.3, mode: Literal['linear', 'sigmoid', 'pool'] = 'sigmoid', margin: float = 0.05, contacts: set[tuple[int, int]] | None = None, maximum_depth: int | None = None, completion: Mapping | None = None) -> Self",
          "summary": "Construct a landscape from WT and singles without enumerating variants."
        }
      ],
      "title": "Advanced construction"
    }
